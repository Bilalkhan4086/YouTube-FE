API_PROXY_TARGET=http://localhost:8000
# Optional separate public API origin. Leave empty to use the /api proxy.
VITE_API_BASE_URL=
# Public site origin for blog canonical URLs, structured-data URLs, and sitemap.
# Example: https://your-domain.com (no path). Leave blank for local development.
# On Vercel, falls back to VERCEL_PROJECT_PRODUCTION_URL when blank.
# Never set localhost as the Production SITE_URL in Vercel.
SITE_URL=
